#!/bin/sh
# This repository has one author. Strip co-author and AI attribution trailers
# before Git creates the commit.
set -e
file="$1"
[ -n "$file" ] && [ -f "$file" ] || exit 0

python3 - "$file" <<'PY'
from pathlib import Path
import re
import sys

path = Path(sys.argv[1])
drop = re.compile(
    r"^(?:"
    r"Co-Authored-By:\s*.+"
    r"|(?:🤖\s*)?Generated with .*Claude Code.*"
    r"|Claude-Session:\s*.+"
    r")$",
    re.IGNORECASE,
)

kept = [
    line
    for line in path.read_text().splitlines()
    if not drop.match(line.strip())
]

while kept and not kept[-1].strip():
    kept.pop()

path.write_text("\n".join(kept) + "\n")
PY
