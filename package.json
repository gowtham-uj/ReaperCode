{
  "type": "module",
  "scripts": {
    "test": "node scripts/run-node-tests.mjs",
    "typecheck": "tsc --noEmit && npm run typecheck:web",
    "build": "tsc -p tsconfig.build.json",
    "reaper": "node bin/reaper",
    "reaper:dev": "tsx watch --clear-screen=false scripts/run-reaper.ts",
    "reaper:exec": "node bin/reaper exec run --prompt",
    "build:binary": "node scripts/build-bundle.mjs",
    "stress": "node --import=tsx scripts/stress-reaper.ts",
    "typecheck:web": "tsc -p web/shared/tsconfig.json && tsc -p web/ui/tsconfig.json",
    "web": "tsx scripts/run-web.ts",
    "web:ui": "vite --config web/ui/vite.config.ts",
    "build:web": "vite build --config web/ui/vite.config.ts",
    "test:web": "vitest run --config web/ui/vitest.config.ts",
    "sync:models": "tsx scripts/sync-models-dev.ts",
    "sync:transports": "tsx scripts/sync-transport-coverage.ts"
  },
