  "name": "reaper",
  "version": "0.1.47",
  "description": "Model-agnostic TypeScript coding agent for long-horizon autonomous work: configurable-token context engineering, layered compaction (shake/microcompact/reactive-compact/full-summary), provider-agnostic model routing (Anthropic, OpenAI, LiteLLM, DeepSeek, Cerebras, OpenRouter, MiniMax, NeuralWatt), unified tool dispatch, ACI file tools, parallel tool islands, verified recovery, skills/hooks/extensions.",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
