*token*.json

# Build/test/eval outputs
dist/
build/
coverage/
reaper_eval/workspaces/
reaper_eval/run_logs/
reaper_eval/parity-runs/
reaper_eval/terminal-bench-runs/
reports/
scratchpad/
*.log

# Local virtualenvs and generated media/docs
.venv*/
.pdf-edit-packages/
*.png
*.jpg
*.jpeg
*.webp
*.pdf
*.docx
# ...except the screenshots the README embeds, which are part of the repo
!docs/screenshots/*.png
# ...and the app icons, which the browser fetches at runtime and which the
# build copies into the bundle. Ignoring these would ship a build whose tab
# icon 404s.
!web/ui/public/*.png
!web/ui/public/*.ico

# Local reference checkouts (never push)
source_codes/
pi-mono-main
oh-my-pi/

# Ignored IDE and harness metadata
.omp/
.cursor/
.pi/
.hermes/
.snapshots/
logs/

# Evaluation and benchmarks
benchmarks/
reaper_eval/

# Local temporary files and research
AGENTS.md
Reaper Implementation Research.md
workspace/

# Ignore all docs except docs/dev/ and the README's screenshots
docs/*
!docs/dev/
!docs/screenshots/

# Ignored agent skills
.agent/skills/

# Temporary smoke tests
scripts/*.mts

# Local scratch that must never be committed.
#
# `focus_sources/` is 1.5GB of extracted source trees used for reading, not for
# building; `.pw-browsers/` and `.e2e/` are Playwright downloads and drive
# artifacts; the rest are generated reports, stray downloads, and one captured
# process log. All of it appeared in the working tree during local work and none
# of it belongs in the repository.
focus_sources/
profile-readme/
.pw-browsers/
.e2e/
audit-report.html
developer-improvement-pack-*.zip
bg-1
HQFiLt-aQAAhvAh.jfif

# Generated analysis traces from local harness runs.
tool-discovery-trace.json
*-trace.json

# Steel's browser is a 1 GB clone, not a source dependency. It is fetched and
# run as a service; the two fixes Reaper needs are recorded as a patch in
# .reaper/steel-patches.{md,patch} so a fresh clone can be brought up to date
# without carrying the whole tree in this repository's history.
vendor/
.scratch/
.scratch/

# Local agent tooling state, not project code.
.claude/
